{
  "name": "WLASL Pose-TGCN (2000 Words)",
  "model_file": "wlasl_pose_tgcn.onnx",
  "version": "1.0",
  "author": "dxli94",
  "description": "Word-level sign language recognition using 55 upper-body keypoints via OpenPose (BODY_25 + hands).",
  "type": "word_level",
  "labels": "labels.json",

  "input": {
    "landmark_source": "openpose",
    "max_hands": 2,
    "detection_confidence": 0.6,
    "tracking_confidence": 0.7,
    "model_complexity": 0,

    "openpose_model_folder": "",
    "openpose_net_resolution": "-1x256",
    "openpose_hand": true,
    "openpose_face": false,

    "camera_resolution": [640, 480],
    "recognition_frame_skip": 2,

    "input_shape": [1, 55, 100],

    "use_dimensions": 2,

    "normalize": "frame"
  },

  "inference": {
    "type": "sequence",

    "confidence_threshold": 0.65,

    "backend": "onnx",

    "sequence_length": 50,
    "stride": 2,

    "apply_softmax": true
  },

  "postprocess": {
    "misrecognition_fixes": false,
    "spell_correction": false,

    "stability_frames": 5,

    "repeat_frames": 30,

    "max_consecutive": 1,

    "cooldown_frames": 25,
    "diff_cooldown_frames": 5,

    "high_confidence_threshold": 0.80,
    "high_confidence_frames": 2,

    "smooth_window": 9,

    "min_smooth_confidence": 0.60,

    "word_timeout": 2.0,
    "sentence_timeout": 4.0
  }
}